# Compartido con backend/.env (IA_LOTES_TOKEN). Si queda vacío, el
# microservicio acepta cualquier llamada: sólo es admisible en localhost.
IA_LOTES_TOKEN=

# DelineateAnythingv2.pt es el más preciso (+103% mAP sobre el original) y en
# CPU resuelve un campo típico en segundos. DelineateAnything-S.pt es más
# rápido y menos preciso; DelineateAnything.pt es la versión original.
IA_LOTES_PESOS=DelineateAnythingv2.pt
# Ruta a un .pt ya descargado, para no depender de Hugging Face en cada máquina.
IA_LOTES_PESOS_LOCALES=

# auto, cpu o cuda.
IA_LOTES_DISPOSITIVO=auto

# Umbrales de detección. Ojo: el modelo califica bajo en este dominio, así que
# subir la confianza no "limpia ruido", directamente pierde lotes enteros
# (medido: a 0.25 desaparecen los potreros de pasto). El IoU es el de NMS y va
# alto a propósito: los lotes diagonales tienen cajas muy solapadas y con un
# umbral bajo se suprimen vecinos legítimos.
IA_LOTES_CONFIANZA=0.10
IA_LOTES_IOU=0.70

# 512 es el tamaño de tile con el que se entrenó el modelo: no conviene cambiarlo.
IA_LOTES_VENTANA=512
IA_LOTES_SOLAPE=0.25

# Cuántos zooms mirar alrededor del elegido. Con una sola escala el modelo se
# pierde lotes que sólo se ven más grandes o más chicos: medido, pasar de 1 a 3
# subió de 41 a 63 detecciones sobre el mismo campo. Cada escala suma tiempo.
IA_LOTES_ESCALAS=3

# Techos del mosaico satelital. El zoom no se maximiza: se elige el que deja el
# mosaico cerca de 768 px de lado, que es donde entran varios lotes por ventana.
IA_LOTES_ZOOM_MAXIMO=19
IA_LOTES_PIXELES_MAXIMOS=2048
IA_LOTES_TILES_MAXIMOS=144
