NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://usuario:contraseña@host/base_de_datos
# Debe ser una base/branch descartable distinta; las integraciones truncan tablas.
TEST_DATABASE_URL=postgresql://usuario:contraseña@host/base_de_datos_de_prueba
AUTH_JWT_SECRET=pon_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres

# Orígenes públicos exactos del frontend, separados por comas cuando haya más de uno.
# En desarrollo con el proxy de Vite puede quedar vacío.
CORS_ORIGINS=

# Cantidad de proxies confiables entre Internet y Express. Vacío equivale a false.
TRUST_PROXY=

# lax, strict o none. "none" sólo se admite en producción y siempre agrega Secure.
COOKIE_SAME_SITE=lax

# Opcionales: si faltan, el resto de RODEO sigue funcionando.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Microservicio Python de sugerencia de lotes (carpeta ia-lotes/). Vacío
# apaga el botón "Subdividir con IA" sin romper nada más.
IA_LOTES_URL=
# Debe coincidir con IA_LOTES_TOKEN del microservicio.
IA_LOTES_TOKEN=
# El server corta las requests a los 90 s: no subir esto más allá de eso.
IA_LOTES_TIMEOUT_MS=75000
